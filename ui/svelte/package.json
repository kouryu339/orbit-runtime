{
  "name": "@agent-runtime/ui-svelte",
  "version": "0.1.0",
  "private": true,
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "build": "vite build",
    "build:library": "vite build --config vite.lib.config.ts",
    "verify:library": "node scripts/verify-library.mjs",
    "check:styles": "node ../sync-svelte-styles.mjs --check"
  },
  "dependencies": {
    "@agent-runtime/conversation-element": "file:../lit",
    "dompurify": "^3.4.9",
    "katex": "^0.17.0",
    "marked": "^18.0.0",
    "mermaid": "^11.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^24.0.0",
    "happy-dom": "^20.10.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
