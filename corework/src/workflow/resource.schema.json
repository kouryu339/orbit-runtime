{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbit:workflow:resource:v1",
  "title": "Orbit Workflow Resource v1",
  "description": "完整注册文档；state 区分 draft/registered。首次 revision 为 1，更新提交当前 revision，由 Runtime 递增。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "metadata",
    "state",
    "revision",
    "logic"
  ],
  "properties": {
    "schema": {
      "const": "orbit.workflow.resource/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "稳定资源 ID；首次指定后不随重命名或逻辑编辑改变。"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "extensions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "description": "按宿主命名空间保存的业务扩展，编译器不解释。",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "state": {
      "enum": [
        "draft",
        "registered"
      ],
      "description": "首次注册时声明状态；已有资源修改成功统一转为 draft，转正必须通过 promote。"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "首次为 1；更新提交当前值，由 Runtime 在成功保存后递增。"
    },
    "logic": {
      "$ref": "urn:orbit:workflow:logic:v1"
    }
  },
  "$defs": {
    "logic": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:orbit:workflow:logic:v1",
      "title": "Orbit Workflow Logic v1",
      "description": "源文本解析后的结构 Schema；不能直接用 JSON Schema 解析 .workflow 裸表达式文本。ID 及作用域由 Runtime 验证。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "steps"
      ],
      "properties": {
        "schema": {
          "const": "orbit.workflow.logic/v1"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "default": true,
              "disablename": {
                "type": "string",
                "description": "可选的用户可见名称；不改变引用标识。"
              },
              "description": {
                "type": "string",
                "description": "供 AI 阅读，用短句说明用途和限制。"
              }
            }
          }
        },
        "steps": {
          "$ref": "#/$defs/block"
        },
        "returns": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/return"
          }
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/variable"
          }
        }
      },
      "$defs": {
        "expr": {
          "oneOf": [
            {
              "type": [
                "null",
                "boolean",
                "number",
                "string",
                "array"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "literal"
              ],
              "properties": {
                "literal": true
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input"
              ],
              "properties": {
                "input": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "local"
              ],
              "properties": {
                "local": {
                  "enum": [
                    "item",
                    "index"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step",
                "output"
              ],
              "properties": {
                "step": {
                  "$ref": "#/$defs/id"
                },
                "output": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fn",
                "args"
              ],
              "properties": {
                "fn": {
                  "type": "string"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/expr"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "var"
              ],
              "properties": {
                "var": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "expression"
              ],
              "properties": {
                "expression": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "array"
              ],
              "properties": {
                "array": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/expr"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "object"
              ],
              "properties": {
                "object": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/expr"
                  }
                }
              }
            }
          ],
          "description": "解析后的内部表达式结构。源文本仅在节点 args 和 returns.*.value 支持裸引用/Pure；带引号的值始终是字符串常量。"
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expr"
          }
        },
        "block": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "step": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            }
          },
          "oneOf": [
            {
              "required": [
                "call",
                "args"
              ],
              "properties": {
                "call": {
                  "type": "string"
                },
                "args": {
                  "$ref": "#/$defs/args"
                }
              }
            },
            {
              "required": [
                "if",
                "then",
                "otherwise"
              ],
              "properties": {
                "if": {
                  "$ref": "#/$defs/expr"
                },
                "then": {
                  "$ref": "#/$defs/block"
                },
                "otherwise": {
                  "$ref": "#/$defs/block"
                }
              }
            },
            {
              "required": [
                "for",
                "body"
              ],
              "properties": {
                "for": {
                  "$ref": "#/$defs/expr"
                },
                "body": {
                  "$ref": "#/$defs/block"
                }
              }
            },
            {
              "required": [
                "switch",
                "cases",
                "default"
              ],
              "properties": {
                "switch": {
                  "$ref": "#/$defs/expr"
                },
                "cases": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "body"
                    ],
                    "properties": {
                      "value": {
                        "type": [
                          "null",
                          "boolean",
                          "number",
                          "string"
                        ]
                      },
                      "body": {
                        "$ref": "#/$defs/block"
                      }
                    }
                  }
                },
                "default": {
                  "$ref": "#/$defs/block"
                }
              }
            },
            {
              "required": [
                "set",
                "value"
              ],
              "properties": {
                "set": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "$ref": "#/$defs/expr"
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        "variable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "initial"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "initial": true,
            "disablename": {
              "type": "string",
              "description": "可选的用户可见名称；不改变引用标识。"
            }
          },
          "description": "工作流级变量，initial 是静态 JSON 字面量；每次运行独立初始化。"
        },
        "return": {
          "oneOf": [
            {
              "$ref": "#/$defs/expr"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "$ref": "#/$defs/expr"
                },
                "disablename": {
                  "type": "string",
                  "description": "可选的用户可见名称；不改变引用标识。"
                },
                "description": {
                  "type": "string",
                  "description": "供 AI 阅读，用短句说明用途和限制。"
                }
              }
            }
          ]
        }
      }
    }
  }
}
